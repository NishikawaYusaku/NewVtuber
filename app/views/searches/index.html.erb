<% content_for(:title, "詳細検索") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 43rem;">
        <%= search_form_for @q, url: root_path do |f| %>
          <h3 class="my-5">詳細検索</h3>
          <div>
            <p><%= f.label "配信サイト" %></p>
            <span class="me-5">
              <%= f.radio_button :places_name_eq, "", id: "place_none" %>
              <%= label_tag "place_none", "指定なし", class: "ms-1 filtering_search_hover" %>
            </span>
            <% ["YouTube","Twitch"].each_with_index do |place, i| %>
              <% radio_id = "place_#{i}" %>
              <span class="me-5">
                <%= f.radio_button :places_name_eq, place, id: radio_id %>
                <%= label_tag radio_id, place, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "所属" %></p>
            <% Vtuber.distinct.pluck(:affiliation).reject(&:blank?).sort_by(&:length).each_with_index do |affiliation, i| %>
              <% checkbox_id = "affiliation#{i}" %>
              <span class="me-5 d-inline-block">
                <%= f.check_box :affiliation_eq_any, { multiple: true, include_hidden: false, id: checkbox_id }, affiliation, nil %>
                <%= label_tag checkbox_id, affiliation, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "性別" %></p>
            <% ["男性","女性","その他"].each_with_index do |gender, i| %>
              <% checkbox_id = "gender_#{i}" %>
              <span class="me-5 d-inline-block">
                <%= f.check_box :gender_eq_any, { multiple: true, include_hidden: false, id: checkbox_id }, gender, nil %>
                <%= label_tag checkbox_id, gender, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "言語" %></p>
            <% ["JP","EN","その他"].each_with_index do |language, i| %>
              <% checkbox_id = "language_#{i}" %>
              <span class="me-5 d-inline-block">
                <%= f.check_box :language_eq_any, { multiple: true, include_hidden: false, id: checkbox_id }, language, nil %>
                <%= label_tag checkbox_id, language, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "誕生日" %></p>
            <%= f.select :birthday_month_eq, (1..12).map { |m| ["#{m} 月", m] }, include_blank: "- 月" %><span class="me-2"></span>
            <%= f.select :birthday_day_eq, (1..31).map { |d| ["#{d} 日", d] }, include_blank: "- 日" %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "身長" %></p>
            <%= f.number_field :height_gteq, min: 0, placeholder: '指定なし', style:"width:7rem;" %> 〜
            <%= f.number_field :height_lteq, min: 0, placeholder: '指定なし', style:"width:7rem;" %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "デビュー日" %></p>
            <%= f.select :debut_date_year_eq, (2016..Date.today.year).map { |y| ["#{y} 年", y] }, include_blank: "- 年" %><span class="me-2"></span>
            <%= f.select :debut_date_month_eq, (1..12).map { |m| ["#{m} 月", m] }, include_blank: "- 月" %><span class="me-2"></span>
            <%= f.select :debut_date_day_eq, (1..31).map { |d| ["#{d} 日", d] }, include_blank: "- 日" %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "配信ジャンル" %></p>
            <% ["ゲーム","雑談","歌","ASMR","企画","その他"].each_with_index do |content, i| %>
              <% checkbox_id = "content_#{i}" %>
              <span class="me-5 d-inline-block">
                <%= f.check_box :contents_name_eq_any, { multiple: true, include_hidden: false, id: checkbox_id }, content, nil %>
                <%= label_tag checkbox_id, content, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "タグ" %></p>
            <% Tag.distinct.pluck(:name).sort_by(&:length).each_with_index do |tag, i| %>
              <% checkbox_id = "tag_#{i}" %>
              <span class="me-5 d-inline-block">
                <%= f.check_box :tags_name_eq_any, { multiple: true, include_hidden: false, id: checkbox_id }, tag, nil %>
                <%= label_tag checkbox_id, tag, class: "ms-1 filtering_search_hover" %>
              </span>
            <% end %>
          </div>
          <hr class="my-4">
          <div>
            <p><%= f.label "いいね数" %></p>
            <%= f.number_field :favorites_count_gteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %> 〜
            <%= f.number_field :favorites_count_lteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %>
          </div>
          <hr class="my-4">
          <div id="filtering_search_youtube">
            <div>
              <p><%= f.label "チャンネル登録者数" %></p>
              <%= f.number_field :vtuber_youtube_subscriber_count_gteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %> 〜
              <%= f.number_field :vtuber_youtube_subscriber_count_lteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %>
            </div>
            <hr class="my-4">
            <div>
              <p><%= f.label "動画数" %></p>
              <%= f.number_field :vtuber_youtube_video_count_gteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %> 〜
              <%= f.number_field :vtuber_youtube_video_count_lteq, min: 0, placeholder: '指定なし', style:"width:10rem;" %>
            </div>
            <hr class="my-4">
          </div>
          <%= f.hidden_field :filtering_search, value: true %>
          <div class="text-center my-5">
            <%= f.submit "検索", class: "btn btn-comment px-5", data: { testid: "fs-button" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>