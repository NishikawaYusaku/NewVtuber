<% content_for(:title, "詳細検索") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div style="width: 25rem;">
        <%= search_form_for @q, url: root_path do |f| %>
          <h3 class="mb-5">詳細検索</h3>
          <div class="mb-5">
            <p><%= f.label "配信サイト" %></p>
            <% Place.where(id:[1,2]).each do |place| %>
              <% checkbox_id = "place_#{place.id}" %>
              <span class="me-5">
                <%= f.check_box :places_name_eq_any,
                  { multiple: true,
                    checked: place[:checked],
                    disabled: place[:disabled],
                    include_hidden: false,
                    id: checkbox_id }, place[:name] %>
                <%= label_tag checkbox_id, place.name, class: "me-1" %>
              </span>
            <% end %>
          </div>
          <%= f.hidden_field :filtering_search, value: true %>
          <div class="text-center mb-5">
            <%= f.submit "検索", class: "btn btn-comment px-5" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>