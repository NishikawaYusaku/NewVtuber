<% content_for(:title, "マイページ") %>

<div class="container">
  <div class="row mt-5 pb-4">
    <div class="col col-xl-6 col-lg-7 col-md-9 border mx-2 mx-sm-auto">
      <h4 class="my-3">アカウント情報</h4>
      <div class="py-4 border-top">
        メールアドレス
        <div class="d-flex align-items-center">
          <div class="col-8">
            <%= current_user.email %>
          </div>
          <div class="col d-flex justify-content-end me-5 pe-1">
            <%= link_to "変更", email_user_path, class: "btn btn-user" %>
          </div>
        </div>
      </div>
      <div class="py-4 border-top">
        パスワード
        <div class="d-flex align-items-center">
          <div class="col-8">
            **********
          </div>
          <div class="col d-flex justify-content-end me-5 pe-1">
            <%= link_to "変更", new_password_reset_path, class: "btn btn-user" %>
          </div>
        </div>
      </div>
      <div class="py-4 border-top">
        ユーザー名
        <div class="d-flex align-items-center">
          <div class="col-8">
            <%= current_user.name %>
          </div>
          <div class="col d-flex justify-content-end me-5 pe-1">
            <%= link_to "変更", name_user_path, class: "btn btn-user" %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row mt-5">
    <div class="col col-xl-6 col-lg-7 col-md-9 border mx-2 mx-sm-auto pb-2">
      <h4 class="my-3">いいねしたVTuber</h4>
      <% if @favorites_vtuber.present? %>
        <div id="favorite-index">
          <%= render 'favorites/index', favorites_vtuber: @favorites_vtuber %>
        </div>
      <% else %>
        いません
      <% end %>
    </div>
  </div>
</div>