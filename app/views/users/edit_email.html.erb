<% content_for(:title, "メールアドレスの変更") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 25rem;">
        <%= form_with model: @user, url: email_user_path, local: true do |f| %>
          <%= render 'shared/error_message', object: f.object %>
          <h3 class="mt-5">メールアドレスの変更</h3>
          <div class="mt-5">
            <%= f.label :email, "現在のメールアドレス", class: "form-label" %>
            <p><%= current_user.email %></p>
          </div>
          <div class="mt-5">
            <%= f.label :email, "新しいメールアドレス", class: "form-label" %>
            <%= f.text_field :email, class: "form-control" %>
          </div>
          <div class="text-center my-5">
            <%= f.submit "保存", class: "btn btn-user px-5 ms-3" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>