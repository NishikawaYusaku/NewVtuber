<% content_for(:title, "ユーザー登録") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 30rem;">
        <%= form_with model: @user, url: user_path, local: true do |f| %>
          <%= render 'shared/error_message', object: f.object %>
          <h3 class="my-5">ユーザー登録</h3>
          <div class="mb-5">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email, class: "form-control" %>
          </div>
          <div class="mb-5 password-container">
            <%= f.label :password, "パスワード" %>
            <div class="mb-2">
              <small>8文字以上で設定してください</small>
            </div>
            <%= f.password_field :password, class: "form-control mb-2 password-field" %>
            <div class="d-flex user_checkbox">
              <div>
                <%= check_box_tag "show_password", class: "password-show", id: "password-create" %>
              </div>
              <%= label_tag "password-create", "パスワードを表示する", class: "ps-3" %>
            </div>
          </div>
          <div class="mb-5 password-container">
            <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control mb-2 password-field" %>
            <div class="d-flex user_checkbox">
              <div>
                <%= check_box_tag "show_password", class: "password-show", id: "password-create-confirmation" %>
              </div>
              <%= label_tag "password-create-confirmation", "パスワードを表示する", class: "ps-3" %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :name, "ユーザー名", class: "form-label" %>
            <%= f.text_field :name, class: "form-control " %>
          </div>
          <div class="mb-5 d-flex user_checkbox">
            <div>
              <%= f.check_box :agreement, id: "user-create-agreement" %>
            </div>
            <%= label_tag "agreement", class: "ps-3", for: "user-create-agreement" do %>
              <%= link_to "利用規約", terms_pages_path, target: :_blank, rel: "noopener" %>と<%= link_to "プライバシーポリシー", privacy_policy_pages_path, target: :_blank, rel: "noopener" %>に同意します
            <% end %>
          </div>
          <div class="text-center my-5">
            <%= f.submit "登録する", class: "btn btn-user_create px-5" %>
          </div>
          <div class="text-center my-5">
            <div class="index-name"><%= link_to "アカウントがある方はこちらへ", login_path %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @replace_url %>
  <script>
    history.replaceState('', '', '<%= @replace_url %>')
  </script>
<% end %>