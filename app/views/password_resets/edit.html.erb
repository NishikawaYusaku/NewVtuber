<% content_for(:title, "パスワードの変更") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 25rem;">
        <%= form_with model: @user, url: password_reset_path(@token), local: true do |f| %>
          <h3 class="my-5">パスワードの変更</h3>
          <div class="mb-5 password-container">
            <%= f.label :password, "パスワード" %>
            <div class="mb-2">
              <small>8文字以上で設定してください</small>
            </div>
            <%= f.password_field :password, class: "form-control mb-2 password-field" %>
            <div class="d-flex user_checkbox">
              <div>
                <%= check_box_tag "show_password", class: "password-show", id: "password-edit" %>
              </div>
              <%= label_tag "password-edit", "パスワードを表示する", class: "ps-3" %>
            </div>
          </div>
          <div class="mb-5 password-container">
            <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control mb-2 password-field" %>
            <div class="d-flex user_checkbox">
              <div>
                <%= check_box_tag "show_password", class: "password-show", id: "password-edit-confirmation" %>
              </div>
              <%= label_tag "password-edit-confirmation", "パスワードを表示する", class: "ps-3" %>
            </div>
          </div>
          <div class="text-center mb-5">
            <%= f.submit "保存する", class: "btn btn-user px-5" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @replace_url %>
  <script>
    history.replaceState('', '', '<%= @replace_url %>')
  </script>
<% end %>