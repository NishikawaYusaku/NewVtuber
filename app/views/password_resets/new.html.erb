<% content_for(:title, "パスワードの変更") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 32rem;">
        <%= form_with url: password_resets_path, local: true, method: :post do |f| %>
          <h3 class="mt-5">パスワードの変更</h3>
          <p>下記のメールアドレス宛に変更のご案内をお送りします。</p>
          <div class="mt-5">
            <%= f.label :email, "ご登録のメールアドレス", class: "form-label" %>
            <% if logged_in? %>
              <div class="text-left">
                <%= current_user.email %>
              </div>
            <% else %>
              <%= f.email_field :email, class:"form-control" %>
            <% end %>
          </div>
          <div class="text-center my-5">
            <%= f.submit "送信", class: "btn btn-user px-5 ms-3" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>