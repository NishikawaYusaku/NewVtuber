<p class="text-secondary">
  <span class="me-4">
    <%= "#{comment.user.name}" %>
  </span>
  <% if comment.created_at == comment.updated_at %>
    <%= "#{l comment.updated_at}" %>
  <% else %>
    <%= "#{l comment.updated_at}（編集済み）" %>
  <% end %>
</p>

<%= form_with(model:[vtuber, comment], local: false) do |f|%>
  <%= f.text_area :body, value: comment.body, class: "form-control comment_textarea", id: "comment-textarea-#{comment.id}" %>
  <div id="comment-button-<%= comment.id %>" class="mt-3">
    <button data-cancel-id="<%= comment.id %>" type="button" class="btn btn-secondary comment-cancel-button">やめる</button>
    <%= f.submit "更新する", class: "btn btn-comment" %>
  </div>
<% end%>