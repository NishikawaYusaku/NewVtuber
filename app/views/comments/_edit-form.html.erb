<div class="mt-2 text-secondary">
  <span class="index-name">
    <%= comment.user.name %>
  </span>
  <div class="d-flex">
    <%= l comment.updated_at %><%= "（編集済み）" if comment.created_at != comment.updated_at %>
  </div>
</div>

<%= form_with(model:[vtuber, comment], local: false) do |f|%>
  <%= f.text_area :body, value: comment.body, class: "form-control comment_textarea mt-4", id: "comment-textarea-#{comment.id}" %>
  <div id="comment-button-<%= comment.id %>" class="mt-3 mb-4">
    <button data-cancel-id="<%= comment.id %>" type="button" class="btn btn-cancel comment-cancel-button me-3">やめる</button>
    <%= f.submit "更新する", class: "btn btn-comment" %>
  </div>
<% end%>