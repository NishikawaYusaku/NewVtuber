<% content_for(:title, "ログイン") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user" style="width: 25rem;">
        <%= form_with url: login_path, local: true do |f| %>
          <h3 class="my-5">ログイン</h3>
          <div class="mb-5">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email, class: "form-control" %>
          </div>
          <div class="mb-5 password-container">
            <%= f.label :password, "パスワード", class: "form-label" %>
            <%= f.password_field :password, class: "form-control mb-2 password-field" %>
            <div class="d-flex user_checkbox">
              <div>
                <%= check_box_tag "show_password", class: "password-show", id: "password-login" %>
              </div>
              <%= label_tag "password-login", "パスワードを表示する", class: "ps-3" %>
            </div>
          </div>
          <div class="text-center mb-5">
            <%= f.submit "ログインする", class: "btn btn-user_create px-5" %>
          </div>
          <div class="text-center">
            <div class="mb-4 index-name"><%= link_to "パスワードを忘れた方はこちらへ", new_password_reset_path %></div>
            <div class="mb-5 index-name"><%= link_to "アカウントをお持ちでない方はこちらへ", new_user_path %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
