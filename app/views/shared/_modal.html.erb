<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">VTuberのプロフィールの設定</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= form_with url: '/vtubers/name_input', local: true do |f| %>
          <div class="mb-3">
            <%= f.label :name, "VTuberのお名前", class: "form-label" %>
            <%= f.text_field :name, class: "form-control profile_setting_textbox", id: "name-setting", value: @vtuber ? @vtuber.name : "" %>
          </div>
          <div class="text-center mt-4 mb-2">
            <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal">やめる</button>
            <%= f.submit "設定する", class: "btn btn-setting ms-3", data: { testid: "profile-modal-button" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="modal fade px-3" id="cancel_set_vprofile" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered mx-auto">
    <div class="modal-content text-center py-5">
      <div><span class="px-5 index-name">内容は保存されませんが、設定を終了しますか？</span></div>
      <div class="d-flex flex-wrap-reverse justify-content-center row-gap-4 mt-5">
        <button type="button" class="btn btn-setting mx-4" data-bs-dismiss="modal">設定を続ける</button>
        <span class="mx-4" data-bs-dismiss="modal">
          <%= link_to "設定を終了する", root_path, class: "btn btn-secondary" %>
        </span>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="notify-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
</div>