<% favorites_vtuber.each do |v| %>
  <div class="d-flex align-items-center border-top hover_mypage-favorite">
    <div class="col-sm-9 col-7">
      <div class="d-flex align-items-center text-left my-2 ps-2">
        <% case v.gender %>
        <% when "男性" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #0000ff;" %>
        <% when "女性" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #ff0000;" %>
        <% when "その他" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #ffff00;" %>
        <% when nil then %>
          <%= image_tag v.image.url, class: "rounded-circle border border-black", size: "50x50" %>
        <% end %>
        <span class="ms-3 multiline-ellipsis">
          <%= v.name %>
        </span>
      </div>
    </div>
    <div class="col d-flex justify-content-end align-items-center">
      <%= link_to "見る", vtuber_path(v.id), class: "btn btn-user" %>
      <button type="button" class="nav-link ms-4 me-2" data-bs-toggle="modal" data-bs-target="#mypage-favorite-<%= v.id %>", id="profile-modal", data-testid="mypage-heart" >
        <i class="fa-solid fa-heart fa-lg mypage-favorite-icon" aria-hidden="true", style="color: red;"></i>
      </button>
      <div class="modal fade" id="mypage-favorite-<%= v.id %>" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered mx-auto", style="width: 300px;">
          <div class="modal-content text-center py-4">
            お気に入りを解除しますか？
            <div>
              <span class="mx-4 my-5 index-name">
                <%= v.name %>
              </span>
            </div>
            <div class="d-inline">
              <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal">やめる</button>
              <span class="ms-3" data-bs-dismiss="modal">
                <%= link_to "解除する", favorite_user_path(v), method: :delete, remote: true, class: "btn btn-user", data: {testid: "mypage-heart-delete"} %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>