<% favorites_vtuber.each do |v| %>
  <div class="d-flex align-items-center border-top hover_mypage-favorite">
    <div class="col-8">
      <div class="d-flex align-items-center text-left my-2">
        <% case v.gender %>
        <% when "男性" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #0000ff;" %>
        <% when "女性" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #ff0000;" %>
        <% when "その他" then %>
          <%= image_tag v.image.url, class: "rounded-circle", size: "50x50", style: "border: solid; border-color: #ffff00;" %>
        <% when nil then %>
          <%= image_tag v.image.url, class: "rounded-circle border border-black", size: "50x50" %>
        <% end %>
        <span class="ms-3 multiline-ellipsis">
          <%= v.name %>
        </span>
      </div>
    </div>
    <div class="col d-flex justify-content-end align-items-center">
      <%= link_to "見る", vtuber_path(v.id), class: "btn btn-user" %>
      <%= link_to favorite_user_path(v), method: :delete, remote: true, class: "ms-4 me-2 text-decoration-none link-dark", data: {testid: "mypage-heart"} do %>
        <i class="fa-solid fa-heart fa-lg mypage-favorite-icon" aria-hidden="true", style="color: red;"></i>
      <% end %>
    </div>
  </div>
<% end %>