<div class="container">
  <div class="row mt-5">
    <% if @vtubers.present? %>
    <p class="mb-5">
      <% if @q_name && @invalid.nil? %>
        <%= "「#{@q_name.instance_of?(Array) ? @q_name[0] : @q_name}」の検索結果：#{@results.size}件" %>
      <% elsif @filtering_search %>
        <%= "詳細検索の結果：#{@results.size}件" %>
      <% else %>
        <%= "#{@results.size}件" %>
      <% end %>
      <%= "（#{@range_start}〜#{@range_end}件目）" %>
    </p>
      <% @vtubers.each do |vtuber| %>
        <div class="col-xl-3 col-lg-4 col-md-5">
          <div class="pb-2 mb-5 profile-hover">
            <%= link_to vtuber_path(vtuber.id), class: "text-decoration-none" do %>
              <div class="text-center">
                <div class="pt-3">
                  <% case vtuber.gender %>
                    <% when "男性" then %>
                      <%= image_tag vtuber.image.url, class: "rounded-circle", size: "250x250", style: "border: solid; border-color: #0000ff;" %>
                    <% when "女性" then %>
                      <%= image_tag vtuber.image.url, class: "rounded-circle", size: "250x250", style: "border: solid; border-color: #ff0000;" %>
                    <% when "その他" then %>
                      <%= image_tag vtuber.image.url, class: "rounded-circle", size: "250x250", style: "border: solid; border-color: #ffff00;" %>
                    <% when nil then %>
                      <%= image_tag vtuber.image.url, class: "rounded-circle border border-black", size: "250x250" %>
                  <% end %>
                </div>        
                <div class="mt-3 mx-3 fs-2 text-body index-name">
                  <span class="multiline-ellipsis">
                    <%= vtuber.name %>
                  </span>
                </div>
              </div>
            <% end %>
            <div class="text-center">
              <div class="d-flex justify-content-center align-items-center">
                <%= link_to vtuber.vtuber_places.last.url, class: "mx-4 sns-logo" do %>
                  <% case vtuber.vtuber_places.last.place.name %>
                  <% when "YouTube" then %>
                    <%= image_tag "logo-youtube.png", size: "60x52" %>
                  <% when "Twitch" then %>
                    <%= image_tag "logo-twitch.png", size: "30x35", class:"my-2" %>
                  <% end %>
                <% end %>
                <% if vtuber.name_x.present? %>
                  <%= link_to "https://twitter.com/#{vtuber.name_x}", class: "mx-4 sns-logo" do %>
                    <%= image_tag "logo-x.png", size: "25x26" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col">
        登録されていません
      </div>
    <% end %>
  </div>
  
  <div class="row my-5 pb-5">
    <div class="col d-flex justify-content-center mt-5 pb-5">
      <%= paginate @vtubers, theme: 'bootstrap-5' %>
    </div>
  </div>
</div>
