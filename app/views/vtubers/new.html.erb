<% content_for(:title, "作成") %>

<div class="container">
  <div class="row">
    <div class="d-flex justify-content-center my-5 py-5">
      <div class="px-5 border background-user">
        <%= form_with model: @vtuber, url: vtubers_path, local: true, id: "content_setting" do |f| %>
          <%= render 'shared/error_message', object: f.object %>
          <h3 class="my-5">プロフィール作成</h3>
          <div class="mb-5">
            <%= f.label :name, "VTuberのお名前", class: "form-label" %><small class="text-danger fw-semibold">（必須）</small>
            <%= f.text_field :name, class: "form-control profile_setting_textbox" %>
          </div>
          <%= f.fields_for :vtuber_places do |place_fields| %>
            <div class="mb-5">
              <%= place_fields.label :place_id, "配信サイト", class: "form-label" %><small class="text-danger fw-semibold">（必須）</small>
              <div class="input-group">
                <%= place_fields.collection_select(:place_id, Place.where(id:[1,2]), :id, :name, {prompt: "選択"}, {class: "btn profile_setting_place", data: {testid: "place-select"}} ) %>
                <%= place_fields.text_field :url, class: "form-control profile_setting_textbox", placeholder: "選択した配信サイトのチャンネルURL", data: {testid: "place-url"} %>
              </div>
            </div>
          <% end %>
          <div class="mb-5 col-md-5 col-sm-7">
            <%= f.label :name_x, "Xのユーザー名", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text" id="basic-addon1">@</span>
              <%= f.text_field :name_x, class: "form-control profile_setting_textbox", id: "name_x" %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :language, "言語", class: "form-label" %>
            <div>
              <% ["JP","EN","その他"].each_with_index do |language, i| %>
                <% radio_id = "language_#{i}" %>
                <span class="me-5">
                  <%= f.radio_button :language, language, id: radio_id %><%= f.label :radio_id, language, for: radio_id, class: "ms-1 profile_setting_hover" %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :affiliation, "所属", class: "form-label" %>
            <div id="affiliation_autocomplete">
              <%= f.radio_button :affiliation, "個人", id: "affiliation_individual" %>
              <%= f.label :affiliation_individual, "個人", for: "affiliation_individual", class: "profile_setting_hover me-5" %>
              <%= f.radio_button :affiliation, "", id: "affiliation_company" %>
              <%= f.label :affiliation_company, "企業（グループなど）", for: "affiliation_company", class: "profile_setting_hover me-5" %>
              <%= f.text_field :affiliation, id: "affiliation_name", placeholder: "企業 / グループ名", class: "mt-2 form-control profile_setting_textbox", style: "display: none;" %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :gender, "性別", class: "form-label" %>
            <div>
              <% ["男性","女性","その他"].each_with_index do |gender, i| %>
                <% radio_id = "gender_#{i}" %>
                <span class="me-5">
                  <%= f.radio_button :gender, gender, id: radio_id %><%= f.label :radio_id, gender, for: radio_id, class: "ms-1 profile_setting_hover" %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :debut_date, "デビュー日", class: "form-label" %>
            <div>
              <%= raw sprintf(f.date_select(:debut_date, start_year: 2016, end_year: Date.today.year, use_month_numbers: true, prompt: { year: "-", month: "-", day: "-" }, date_separator: '%s'),'年 ', '月 ') + '日' %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :birthday, "誕生日", class: "form-label" %>
            <div>
              <%= raw sprintf(f.date_select(:birthday, discard_year: true, use_month_numbers: true, prompt: { month: "-", day: "-" }, date_separator: '%s'),'月 ') + '日' %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :height, "身長", class: "form-label" %>
            <div>
              <%= f.number_field :height, min: 0, step: "0.1", style: "width: 7rem;", class: "me-2 profile_setting_textbox" %>cm
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :blood_type, "血液型", class: "form-label" %>
            <div>
              <% ["A","O","B","AB","？"].each_with_index do |blood_type, i| %>
                <% radio_id = "blood_type_#{i}" %>
                <span class="me-5">
                  <%= f.radio_button :blood_type, blood_type, id: radio_id %><%= f.label :radio_id, blood_type, for: radio_id, class: "ms-1 profile_setting_hover" %>
                </span>
              <% end %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :content, "配信ジャンル（複数選択可能）", class: "form-label" %>
            <div>
              <%= f.collection_check_boxes(:content_ids, Content.all, :id, :name) do |c| %>
                <%= c.label do %>
                  <%= c.check_box %><span class="ms-1 profile_setting_hover me-5"><%= c.text %></span>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="mb-5">
            <%= f.label :like, "好きなこと", class: "form-label" %>
            <%= f.text_field :like, class: "form-control profile_setting_textbox" %>
          </div>
          <div class="mb-5">
            <%= f.label :unlike, "嫌いなこと", class: "form-label" %>
            <%= f.text_field :unlike, class: "form-control profile_setting_textbox" %>
          </div>
          <div class="mb-5">
            <%= f.label :image, "アイコン", class: "form-label" %>
            <%= f.file_field :image, class: "form-control profile_setting_textbox", id: "vtuber_image" %>
            <%= f.hidden_field :remove_image, id: "remove_image" %>
            <small>（配信サイトがYouTubeの方で未選択の場合はチャンネルのアイコンになります）</small>
            <div class="preview_image"></div>
          </div>
          <div class="mb-5">
            <%= f.label :tag, "タグ", class: "form-label" %>
            <%= f.text_field :tag, class: "form-control profile_setting_textbox", placeholder: "「、」で区切って入力してください" %>
          </div>
          <div class="text-center mb-5 pt-5">
            <%= link_to "戻る", root_path, class: "btn btn-secondary mx-4" %>
            <%= f.button "登録", type: 'button', onclick: 'submit();', class: "btn btn-setting mx-4", data: {testid: "profile-create"} %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>